# CapitalTrade Advisor — environment variables.
# Copy to .env.local for local development. `neon deploy` / `neon env pull`
# writes the database variables for you.

# --- Database (Neon Postgres) — required -------------------------------------
# Pooled connection (hostname contains "-pooler"). Used by the app for queries.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler"). Used only by scripts: migrate, seed, recompute, user:create.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon branch name, written by the Neon CLI. Informational.
NEON_BRANCH="production"

# --- MT5 sync — required for the MT5 worker ---------------------------------------
# Shared secret the worker sends as X-Ingest-Key. 32+ random characters; put the same
# value in mt5-worker/.env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MT5_INGEST_KEY="replace-with-a-long-random-secret"
# Public key that encrypts investor passwords (the app can't decrypt them). Created by `npm run mt5:keygen`,
# which also puts the matching PRIVATE key in mt5-worker/.env. Add this one to Vercel as well.
MT5_CREDENTIALS_PUBLIC_KEY=""

# --- First admin (used by `npm run db:seed`) — optional ---------------------------
# Without these, the seed creates admin@capitaltrade.com with a generated password
# and prints it once.
# ADMIN_EMAIL="owner@example.com"
# ADMIN_PASSWORD="choose-a-long-password"
# ADMIN_NAME="Owner"

# --- `npm run user:create` — optional --------------------------------------------
# Password to set; otherwise one is generated and printed.
# USER_PASSWORD="choose-a-long-password"

# Set automatically by Vercel; enables closing idle DB connections on Fluid compute.
# VERCEL=1
