# CapitalTrade MT5 worker. Copy to .env on the worker machine. Never commit .env.

# The worker's OWN portable MT5 terminal (see README: "A separate MT5 copy for the worker").
# Never the trader's terminal: logging in from the worker switches that terminal's account.
MT5_PATH=C:\MT5-Sync\terminal64.exe
# Optional: several portable copies to sync in parallel (accounts are split across them).
# MT5_PATHS=C:\MT5-Sync\terminal64.exe;C:\MT5-Sync-2\terminal64.exe
# Only if nobody ever trades on this machine's normal terminal:
# ALLOW_SHARED_TERMINAL=true

# The CapitalTrade app and the same MT5_INGEST_KEY as set in the app's environment.
API_URL=https://your-app.vercel.app
MT5_INGEST_KEY=paste-the-same-long-random-key-here

# Decrypts the investor passwords saved in the app. Written here by `npm run mt5:keygen`
# (run in the app folder). Keep it ONLY on the worker machine.
MT5_CREDENTIALS_PRIVATE_KEY=

# How much history the very first sync of an account pulls.
LOOKBACK_DAYS_FIRST_RUN=90
# The sync interval is set in the app (Settings -> MT5 Connection). To override it here:
# SYNC_INTERVAL_SECONDS=300
