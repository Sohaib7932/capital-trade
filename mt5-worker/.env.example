# Copy to .env on the VPS. Never commit .env.

# Full path to the MT5 terminal installed from your broker.
MT5_PATH=C:\Program Files\YourBroker MetaTrader 5\terminal64.exe

# Single account (or use accounts.json for several — it takes priority).
MT5_LOGIN=12345678
# The INVESTOR (read-only) password, not the master/trading password.
MT5_PASSWORD=your-investor-password
# Exactly as shown in MT5 → File → Login to Trade Account.
MT5_SERVER=YourBroker-Live

# The CapitalTrade app, and the same MT5_INGEST_KEY as set in the app's environment.
API_URL=https://your-app.vercel.app
MT5_INGEST_KEY=paste-the-same-long-random-key-here

SYNC_INTERVAL_SECONDS=60
LOOKBACK_DAYS_FIRST_RUN=90
